# --- LLM used to turn a scraped website into a receptionist profile ---
ANTHROPIC_API_KEY=

# --- Voice agent platform (https://vapi.ai) ---
VAPI_API_KEY=
# Base URL Vapi should call for function calls + end-of-call reports.
# Point this at wherever this server is publicly reachable (e.g. an ngrok URL while testing).
PUBLIC_SERVER_URL=https://your-domain-or-tunnel.example.com

# --- Optional: better scraping than a raw fetch. If unset, falls back to a basic fetch+strip. ---
FIRECRAWL_API_KEY=

# --- Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Calendar booking (Google Calendar) ---
# Service account JSON, as a single-line string, with domain-wide delegation
# or shared access to the calendar you want the agent booking into.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary

PORT=3000

# --- Frontend integration ---
FRONTEND_ORIGIN=https://amstech.ai
# Shared secret the frontend sends as an x-onboard-key header when calling /onboard.
# Generate any random string; keep this same value in the frontend's env too.
ONBOARD_API_KEY=

